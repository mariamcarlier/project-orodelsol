# =====================================================
# CONFIGURACIÓN DEL ENTORNO - JOYERÍA ORO DEL SOL
# =====================================================
# Copiar este archivo como .env y completar los valores.
# Nunca subir el archivo .env real a Git.
#
# Cada desarrollador debe ejecutar:
# Copy-Item .env.example .env

# Django
DJANGO_SECRET_KEY=coloca_aqui_una_clave_secreta

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Correo electrónico SMTP (Gmail)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
